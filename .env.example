# Copy to .env and fill in.  .env is git-ignored: never commit it.

# simulated = rehearse the dashboard and the AI flow without GitHub/NKP
# live      = real GitHub, real cluster
MODE=simulated

# ---------------------------------------------------------------- GitHub
# Fine-grained personal access token, restricted to the vibe-demo-app repo ONLY
# (github.com > Settings > Developer settings > Fine-grained tokens):
#   Repository access : Only select repositories -> vibe-demo-app
#   Permissions       : Contents: Read and write
#                       Actions : Read and write   (read the runs, start the on-hold build)
#                       Metadata: Read-only        (added automatically)
# The AI can push the app, nothing else: it cannot modify this platform repo.
GITHUB_TOKEN=
GITHUB_OWNER=
APP_REPO=vibe-demo-app
# owner/name of THIS repo on GitHub (hosts the reusable workflow). Default: $GITHUB_OWNER/nkp-vibe-demo-dashboard
PLATFORM_REPO=
# Local clone of the app repo (default: next to this folder)
APP_REPO_DIR=../vibe-demo-app

# ------------------------------------------------------------------- NKP
# Management cluster kubeconfig - only used by setup/01-create-project.sh
# Leave empty to use your current kubectl context
MGMT_KUBECONFIG=
WORKSPACE_NAME=default-workspace
# Kommander name of the cluster that runs the demo app (01 lists them if empty)
TARGET_CLUSTER=
PROJECT_NAME=vibe-demo
# Workload cluster kubeconfig (where the project namespace lives).
# Leave commented to use your shell's KUBECONFIG / current kubectl context.
# KUBECONFIG=~/.kube/vibe-workload.conf
# KUBE_CONTEXT=
NAMESPACE=vibe-demo
# ID of the GitOps Source created in the NKP project (= name of the Flux Kustomization)
GITOPS_SOURCE=vibe-demo-app

# ------------------------------------------------------------- Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8090

# Step deadlines in seconds after the push (cumulative). Defaults are fine.
# TIMEOUT_GITHUB_ACTION=420
# TIMEOUT_CONTRACT_ACCEPTED=600
# TIMEOUT_DEPLOYMENT=720
# TIMEOUT_APP_READY=780

# Simulation only: make a step fail (git_push, github_action, contract_accepted,
# deployment, app_ready) and speed up time (2 = twice as fast)
# SIMULATE_FAIL=deployment
# SIMULATE_SPEED=1
